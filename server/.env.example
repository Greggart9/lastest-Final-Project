PORT=5001
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
FRONTEND_URL=http://localhost:3000

# ===================================================
# Cloudflare R2
# ===================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=educollab-materials
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your-bucket-hash.r2.dev

# ===================================================
# Supabase
# ===================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===================================================
# Email Delivery System (SMTP / Resend / Brevo / Gmail)
# If not configured, emails will be safely simulated in console logs
# ===================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM="EduCollab Academic Portal" <noreply@oluwadamilare.xyz>
