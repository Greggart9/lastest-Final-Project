{
  "name": "educollab-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"*\" dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "kill-ports": "npx --yes kill-port 3000 5001",
    "build": "pnpm --filter client build",
    "start": "pnpm --filter client start"
  }
}
